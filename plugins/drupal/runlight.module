<?php

/**
 * @file
 * Adds the Runlight script to every page, and runs Runlight's upkeep.
 *
 * The hooks are in \Drupal\runlight\Hook\RunlightHooks. These functions hand
 * over to it on Drupal 10.3 and 11.0; Drupal 11.1 and later call it directly
 * and skip them.
 *
 * Each does nothing while the class is not yet a service: right after an
 * update from 0.4.1 or earlier, the cached list of hooks still names these
 * functions until caches are rebuilt, and a page should not fail meanwhile.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\runlight\Hook\RunlightHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function runlight_help(string $route_name, RouteMatchInterface $route_match): string {
  return \Drupal::hasService(RunlightHooks::class) ? \Drupal::service(RunlightHooks::class)->help($route_name, $route_match) : '';
}

/**
 * Implements hook_page_attachments().
 */
#[LegacyHook]
function runlight_page_attachments(array &$attachments): void {
  if (\Drupal::hasService(RunlightHooks::class)) {
    \Drupal::service(RunlightHooks::class)->pageAttachments($attachments);
  }
}

/**
 * Implements hook_cron().
 */
#[LegacyHook]
function runlight_cron(): void {
  if (\Drupal::hasService(RunlightHooks::class)) {
    \Drupal::service(RunlightHooks::class)->cron();
  }
}

/**
 * Implements hook_mail().
 */
#[LegacyHook]
function runlight_mail(string $key, array &$message, array $params): void {
  if (\Drupal::hasService(RunlightHooks::class)) {
    \Drupal::service(RunlightHooks::class)->mail($key, $message, $params);
  }
}

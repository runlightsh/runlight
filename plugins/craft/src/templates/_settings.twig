{% import '_includes/forms.twig' as forms %}

<p>{{ 'Runlight counts visitors without cookies and keeps the numbers in your own database. This plugin adds its script to every front-end page and records AI agents that read your pages.'|t('runlight') }}</p>

{% set remote = mode == 'remote' %}

{% if not setUp %}
  <p><a href="{{ cpUrl('settings/plugins/runlight') }}">{{ 'Back to the setup choices'|t('runlight') }}</a></p>
{% endif %}

{% if counting %}
  <div class="readable" style="margin: 16px 0;">
    <p class="success">{{ 'Runlight is counting this site.'|t('runlight') }} <a href="{{ cpUrl('runlight') }}">{{ 'See the numbers'|t('runlight') }}</a></p>
    {% if overdue %}
      <p class="warning">{{ 'Runlight’s upkeep has not run for over a day, so email reports are not sent and old visits are not deleted. Run Craft’s queue, or add `php craft runlight/check` to your server’s cron, hourly.'|t('runlight')|md(null, true) }}</p>
    {% endif %}
    <p class="light">{{ 'Admins and people who may manage Runlight own it, and people who may only see its numbers can read them. Set who may do which under Users, Permissions, Runlight.'|t('runlight') }}</p>
  </div>
{% endif %}

{# Craft namespaces every id in a plugin's settings, so the script looks the element up by the same name. #}
{% if remote and settings.getAddress() and not settings.hasErrors() %}
  {% set statusId = 'runlight-status'|namespaceInputId %}
  <div class="readable" style="margin: 16px 0;">
    <p id="runlight-status" class="light">{{ 'Checking that your Runlight answers…'|t('runlight') }}</p>
  </div>
  {% js %}
    (function () {
      var status = document.getElementById({{ statusId|json_encode|raw }});
      if (!status) return;
      Craft.sendActionRequest("POST", "runlight/dashboard/check").then(function (response) {
        var result = response.data;
        if (!result) { status.remove(); return; }
        status.className = result.ok ? "success" : "error";
        status.textContent = result.message + " ";
        if (result.ok) {
          var link = document.createElement("a");
          link.href = {{ (settings.getAddress() ~ '/')|json_encode|raw }};
          link.target = "_blank";
          link.rel = "noopener";
          link.textContent = {{ 'Open the dashboard'|t('runlight')|json_encode|raw }};
          status.appendChild(link);
        }
      }).catch(function () {
        status.className = "error";
        status.textContent = {{ 'Could not check your Runlight from here.'|t('runlight')|json_encode|raw }};
      });
    })();
  {% endjs %}
{% endif %}

{# Only the fields for where Runlight runs show: its address and keys for another one, locations for this one. #}
{{ forms.radioGroupField({
  label: 'Where Runlight runs'|t('runlight'),
  id: 'mode',
  name: 'mode',
  value: mode,
  toggle: true,
  targetPrefix: 'runlight-',
  options: [
    {
      label: 'In this Craft site'|t('runlight'),
      value: 'local',
      disabled: missing and remote,
    },
    {
      label: 'On a Runlight you run elsewhere'|t('runlight'),
      value: 'remote',
    },
  ],
  instructions: ('In this Craft site, Runlight runs inside this site and keeps its numbers in this site’s database, with a standalone dashboard at `{address}` as well as the one in the Control Panel. There is nothing else to set up. Elsewhere is the standalone server, or an app with Runlight in it, for one dashboard across several sites.'|t('runlight', { address: local ~ '/' })),
  warning: missing ?: null,
}) }}

<div id="runlight-local"{% if remote %} class="hidden"{% endif %}>
{{ forms.lightswitchField({
  label: 'Show which countries visitors come from'|t('runlight'),
  instructions: 'With DB-IP’s free country data, which the plugin downloads from db-ip.com once a month and keeps in Craft’s storage folder, on each server. Visitors’ addresses are looked up on this server and never sent anywhere. Sites behind Cloudflare get countries without it.'|t('runlight'),
  id: 'locations',
  name: 'locations',
  on: settings.locations,
}) }}
</div>

<div id="runlight-remote"{% if not remote %} class="hidden"{% endif %}>
{{ forms.autosuggestField({
  label: 'Runlight address'|t('runlight'),
  instructions: 'Enter your Runlight’s address, shown in Runlight under Settings, Install, and press Connect. Runlight asks you to pick this site, then fills in everything below. That Runlight must count this site, or its visits are ignored.'|t('runlight'),
  id: 'address',
  name: 'address',
  value: settings.address,
  suggestEnvVars: true,
  errors: settings.getErrors('address'),
  placeholder: 'https://example.com/runlight or https://stats.example.com'|t('runlight'),
}) }}

{# Sends this form to ConnectController::actionStart in place of saving it. Without admin changes the page is read-only, with no form to send. #}
{% if craft.app.config.general.allowAdminChanges %}
  <div class="field">
    <button type="button" class="btn submit formsubmit" data-action="runlight/connect/start">{{ 'Connect'|t('runlight') }}</button>
  </div>
{% endif %}

{{ forms.autosuggestField({
  label: 'Site id'|t('runlight'),
  instructions: 'Optional. Shown in Runlight under Settings, Install. Only needed when that Runlight cannot tell this site by its domain.'|t('runlight'),
  id: 'site',
  name: 'site',
  value: settings.site,
  suggestEnvVars: true,
  errors: settings.getErrors('site'),
}) }}

{# A key typed in is hidden like a password; one named by an environment variable shows the variable, with suggestions. #}
{% set observeKey = {
  label: 'Agents key'|t('runlight'),
  instructions: 'Optional. Shown in Runlight under Settings, Install. With it, the plugin reports AI agents such as ChatGPT and Claude reading your pages, which run no JavaScript, so the script cannot see them. The key can report fetches for this site and nothing else. Use an environment variable, such as `$RUNLIGHT_AGENTS_KEY`, which Connect sets up in `.env` itself, to keep it out of project config.'|t('runlight'),
  id: 'observeKey',
  name: 'observeKey',
  value: settings.observeKey,
} %}
{% if settings.observeKey starts with '$' %}
  {{ forms.autosuggestField(observeKey|merge({ suggestEnvVars: true })) }}
{% else %}
  {{ forms.passwordField(observeKey|merge({ autocomplete: 'off' })) }}
{% endif %}

{% set dashboardKey = {
  label: 'Dashboard key'|t('runlight'),
  instructions: 'Optional. Made in Runlight under Settings, Install. With it, the Runlight item in the Control Panel shows this site’s numbers right there, in the same read-only view a share link shows, framed only by this Control Panel. Anyone holding the key can read this site’s dashboard, so keep it as you would a password. Use an environment variable, such as `$RUNLIGHT_DASHBOARD_KEY`, which Connect sets up in `.env` itself, to keep it out of project config.'|t('runlight'),
  id: 'dashboardKey',
  name: 'dashboardKey',
  value: settings.dashboardKey,
} %}
{% if settings.dashboardKey starts with '$' %}
  {{ forms.autosuggestField(dashboardKey|merge({ suggestEnvVars: true })) }}
{% else %}
  {{ forms.passwordField(dashboardKey|merge({ autocomplete: 'off' })) }}
{% endif %}
</div>

{{ forms.lightswitchField({
  label: 'Leave out Control Panel users’ visits'|t('runlight'),
  id: 'skipAdmins',
  name: 'skipAdmins',
  on: settings.skipAdmins,
}) }}

{{ forms.lightswitchField({
  label: 'Count clicks on links to other sites'|t('runlight'),
  id: 'outbound',
  name: 'outbound',
  on: settings.outbound,
}) }}

{{ forms.lightswitchField({
  label: 'Count file downloads'|t('runlight'),
  id: 'downloads',
  name: 'downloads',
  on: settings.downloads,
}) }}

<p>{{ 'Need help? <a href="{url}">Read the Runlight docs.</a>'|t('runlight', { url: 'https://runlight.sh/docs/craft/' })|raw }}</p>

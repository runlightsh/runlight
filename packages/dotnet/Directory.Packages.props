<Project>
  <!-- Every dependency, pinned in one place. The Runlight package has none;
       the database drivers are the app's, and the tests' own. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="3.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
  </ItemGroup>
</Project>

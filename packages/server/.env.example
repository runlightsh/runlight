# Optional scheduled-job monitoring. Configure the mail service in Runlight first.
# Uses that service's saved credentials and verified sender.
CRONWATCH_MAIL_TO=
# Set the public address so alerts link to the monitoring dashboard.
RUNLIGHT_URL=https://analytics.example.com
# Both runlight.db and cronwatch.db persist here on a single-server installation.
DATA_DIR=./runlight-data

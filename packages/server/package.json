{
  "name": "@runlight/server",
  "version": "0.3.2",
  "description": "Runlight as its own server: privacy friendly web analytics for any number of sites, with a login, short links on your own domains, and email reports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runlightsh/runlight.git",
    "directory": "packages/server"
  },
  "homepage": "https://runlight.sh",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "runlight.sh": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "TZ=UTC node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@cronwatch/sdk": "^0.14.3",
    "@runlight/sdk": "0.3.2",
    "better-sqlite3": "^13.0.3",
    "mmdb-lib": "^3.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
